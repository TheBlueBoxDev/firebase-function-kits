{
  "name": "@thebluebox/resize-images",
  "version": "1.0.0-rc.6",
  "description": "Self-managed Firebase Function Kit for resizing uploaded images",
  "author": "TheBlueBoxDev",
  "contributors": [
    "Firebase"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TheBlueBoxDev/firebase-function-kits.git",
    "directory": "packages/resize-images"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    }
  },
  "files": [
    "lib/",
    "npm-shrinkwrap.json",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "NOTICE"
  ],
  "engines": {
    "node": "^22.23.4"
  },
  "scripts": {
    "prepare": "npm run build",
    "build": "npm run clean && npm run compile && node -e \"require('fs').copyFileSync('src/placeholder.png', 'lib/placeholder.png')\"",
    "build:watch": "npm run clean && tsc --watch",
    "clean": "node -e \"require('fs').rmSync('lib', { recursive: true, force: true })\"",
    "compile": "tsc",
    "test": "jest",
    "test:vulnerability": "RUN_VULNERABILITY_TEST=true jest",
    "test:live-content-filter": "NODE_OPTIONS=--experimental-vm-modules RUN_LIVE_CONTENT_FILTER_TESTS=true jest --testPathPattern=integration/content-filter.live",
    "generate-readme": "firebase ext:info .. --markdown > ../README.md"
  },
  "dependencies": {
    "firebase-admin": "^14.2.0",
    "firebase-functions": "^7.4.0",
    "p-queue": "^6.6.2",
    "sharp": "^0.35.5"
  },
  "peerDependencies": {
    "firebase-functions": "^7.4.0",
    "@genkit-ai/vertexai": "^1.42.0",
    "genkit": "^1.42.0"
  },
  "peerDependenciesMeta": {
    "@genkit-ai/vertexai": {
      "optional": true
    },
    "genkit": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^22.20.5",
    "child_process": "^1.0.2",
    "dotenv": "^18.0.8",
    "@genkit-ai/vertexai": "^1.42.0",
    "genkit": "^1.42.0",
    "firebase": "^11.3.1",
    "image-size": "^1.2.0",
    "image-type": "^4.1.0",
    "jest": "^30.5.2",
    "mocked-env": "^1.3.5",
    "ts-jest": "^29.4.15",
    "typescript": "^5.7.3"
  },
  "private": false
}
